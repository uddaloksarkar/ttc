(set-logic QF_LRA)
; 4 dimensions, 4 slanted bodies; exact y-to-x determinant in geometry.csv
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(declare-fun x2 () Real)
(declare-fun x3 () Real)
(assert (or
  (and
    (<= (- 1) (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2))
    (<= (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2) 9)
    (<= (- 1) (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3))
    (<= (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3) 1)
    (<= (- 1) x2)
    (<= x2 1)
    (<= (- 1) x3)
    (<= x3 1)
  )
  (and
    (<= (- 1) (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2))
    (<= (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2) 1)
    (<= (- 1) (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3))
    (<= (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3) 9)
    (<= (- 1) x2)
    (<= x2 1)
    (<= (- 1) x3)
    (<= x3 1)
  )
  (and
    (<= (- 1) (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2))
    (<= (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2) 1)
    (<= (- 1) (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3))
    (<= (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3) 1)
    (<= (- 1) x2)
    (<= x2 9)
    (<= (- 1) x3)
    (<= x3 1)
  )
  (and
    (<= (- 1) (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2))
    (<= (+ (* (/ 5000 7071) x0) (* (/ 5000 7071) x1) x2) 1)
    (<= (- 1) (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3))
    (<= (+ (* (- (/ 5000 7071)) x0) (* (/ 5000 7071) x1) x3) 1)
    (<= (- 1) x2)
    (<= x2 1)
    (<= (- 1) x3)
    (<= x3 9)
  )
))
(check-sat)
