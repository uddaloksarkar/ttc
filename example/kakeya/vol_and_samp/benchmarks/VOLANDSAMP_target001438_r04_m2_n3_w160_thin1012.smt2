(set-logic QF_LRA)
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(declare-fun x2 () Real)
(assert (or
  (and
    (<= -80 x0)
    (<= x0 80)
    (<= -1 x1)
    (<= x1 1)
    (<= (- (/ 1 1012)) x2)
    (<= x2 (/ 1 1012))
  )
  (and
    (<= -1 x0)
    (<= x0 1)
    (<= -80 x1)
    (<= x1 80)
    (<= (- (/ 1 1012)) x2)
    (<= x2 (/ 1 1012))
  )
))
(check-sat)
