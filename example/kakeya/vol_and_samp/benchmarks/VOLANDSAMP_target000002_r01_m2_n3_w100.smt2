(set-logic QF_LRA)
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(declare-fun x2 () Real)
(assert (or
  (and
    (<= -50 x0)
    (<= x0 50)
    (<= -1 x1)
    (<= x1 1)
    (<= (- (/ 1 40)) x2)
    (<= x2 (/ 1 40))
  )
  (and
    (<= -1 x0)
    (<= x0 1)
    (<= -50 x1)
    (<= x1 50)
    (<= (- (/ 1 40)) x2)
    (<= x2 (/ 1 40))
  )
))
(check-sat)
