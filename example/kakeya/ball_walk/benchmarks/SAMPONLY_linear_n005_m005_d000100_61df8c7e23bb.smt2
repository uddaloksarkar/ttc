(set-logic QF_LRA)
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(declare-fun x2 () Real)
(declare-fun x3 () Real)
(declare-fun x4 () Real)
(assert (or
  (and
    (<= (- 1) x0)
    (<= x0 1)
    (<= (- 100) x1)
    (<= x1 100)
    (<= (- (/ 1 100)) x2)
    (<= x2 (/ 1 100))
    (<= (- (/ 1 2)) x3)
    (<= x3 (/ 1 2))
    (<= (- (/ 1 2)) x4)
    (<= x4 (/ 1 2))
  )
  (and
    (<= (- (/ 103 4)) x0)
    (<= x0 (/ 103 4))
    (<= (- (/ 400 103)) x1)
    (<= x1 (/ 400 103))
    (<= (- (/ 1 100)) x2)
    (<= x2 (/ 1 100))
    (<= (- (/ 1 2)) x3)
    (<= x3 (/ 1 2))
    (<= (- (/ 1 2)) x4)
    (<= x4 (/ 1 2))
  )
  (and
    (<= (- (/ 101 2)) x0)
    (<= x0 (/ 101 2))
    (<= (- (/ 200 101)) x1)
    (<= x1 (/ 200 101))
    (<= (- (/ 1 100)) x2)
    (<= x2 (/ 1 100))
    (<= (- (/ 1 2)) x3)
    (<= x3 (/ 1 2))
    (<= (- (/ 1 2)) x4)
    (<= x4 (/ 1 2))
  )
  (and
    (<= (- (/ 301 4)) x0)
    (<= x0 (/ 301 4))
    (<= (- (/ 400 301)) x1)
    (<= x1 (/ 400 301))
    (<= (- (/ 1 100)) x2)
    (<= x2 (/ 1 100))
    (<= (- (/ 1 2)) x3)
    (<= x3 (/ 1 2))
    (<= (- (/ 1 2)) x4)
    (<= x4 (/ 1 2))
  )
  (and
    (<= (- 100) x0)
    (<= x0 100)
    (<= (- 1) x1)
    (<= x1 1)
    (<= (- (/ 1 100)) x2)
    (<= x2 (/ 1 100))
    (<= (- (/ 1 2)) x3)
    (<= x3 (/ 1 2))
    (<= (- (/ 1 2)) x4)
    (<= x4 (/ 1 2))
  )
))
(check-sat)
