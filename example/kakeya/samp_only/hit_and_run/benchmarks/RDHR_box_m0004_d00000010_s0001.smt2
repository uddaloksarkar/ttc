(set-logic QF_LRA)
(declare-fun x0 () Real)
(declare-fun x1 () Real)
(declare-fun x2 () Real)
(assert (or
  (and
    (<= (- 1) x0)
    (<= x0 1)
    (<= (- 100) x1)
    (<= x1 100)
    (<= (- (/ 1 10)) x2)
    (<= x2 (/ 1 10))
  )
  (and
    (<= (- 34) x0)
    (<= x0 34)
    (<= (- (/ 50 17)) x1)
    (<= x1 (/ 50 17))
    (<= (- (/ 1 10)) x2)
    (<= x2 (/ 1 10))
  )
  (and
    (<= (- 67) x0)
    (<= x0 67)
    (<= (- (/ 100 67)) x1)
    (<= x1 (/ 100 67))
    (<= (- (/ 1 10)) x2)
    (<= x2 (/ 1 10))
  )
  (and
    (<= (- 100) x0)
    (<= x0 100)
    (<= (- 1) x1)
    (<= x1 1)
    (<= (- (/ 1 10)) x2)
    (<= x2 (/ 1 10))
  )
))
(check-sat)
